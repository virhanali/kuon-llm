{
  "name": "kuon-2-dense",
  "model": {
    "vocab_size": 24576,
    "block_size": 1024,
    "n_layer": 24,
    "n_embd": 1024,
    "n_head": 16,
    "n_kv_head": 4,
    "ffn_hidden": 2816,
    "dropout": 0.0,
    "tie_word_embeddings": true
  },
  "train": {
    "data_dir": "data/kuon1-data-1b-part3",
    "steps": 12210,
    "batch_size": 8,
    "grad_accum": 5,
    "lr": 3e-4,
    "min_lr": 3e-5,
    "warmup_steps": 500,
    "weight_decay": 0.1,
    "eval_interval": 250,
    "eval_batches": 20,
    "sample_prompt": "Penjualan toko minggu ini turun 15%.",
    "sample_tokens": 96,
    "checkpoint_dir": "checkpoints/kuon-2-dense",
    "log_file": "logs/kuon-2-dense.jsonl",
    "seed": 1337,
    "compile": false,
    "grad_checkpoint": true
  }
}
