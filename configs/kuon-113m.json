{
  "name": "kuon-113m",
  "model": {
    "vocab_size": 16384,
    "block_size": 1024,
    "n_layer": 16,
    "n_embd": 768,
    "n_head": 12,
    "n_kv_head": 4,
    "ffn_hidden": 2048,
    "dropout": 0.0,
    "tie_word_embeddings": true
  },
  "train": {
    "data_dir": "data/cosmopedia",
    "steps": 4000,
    "batch_size": 8,
    "grad_accum": 8,
    "lr": 3e-4,
    "min_lr": 3e-5,
    "warmup_steps": 300,
    "weight_decay": 0.1,
    "eval_interval": 500,
    "eval_batches": 20,
    "sample_prompt": "Photosynthesis is",
    "sample_tokens": 96,
    "checkpoint_dir": "checkpoints/kuon-113m",
    "log_file": "logs/kuon-113m.jsonl",
    "seed": 1337
  }
}
