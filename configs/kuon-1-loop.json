{
  "name": "kuon-1-loop",
  "model": {
    "vocab_size": 24576,
    "block_size": 1024,
    "n_layer": 16,
    "n_embd": 768,
    "n_head": 12,
    "n_kv_head": 4,
    "ffn_hidden": 2048,
    "dropout": 0.0,
    "tie_word_embeddings": true,
    "loop_start": 4,
    "loop_end": 12,
    "loop_passes": 2,
    "loop_gate_rank": 32
  },
  "train": {
    "data_dir": "data/kuon1-stage1",
    "steps": 5000,
    "batch_size": 4,
    "grad_accum": 5,
    "lr": 3e-4,
    "min_lr": 3e-5,
    "warmup_steps": 200,
    "weight_decay": 0.1,
    "eval_interval": 200,
    "eval_batches": 20,
    "sample_prompt": "Penjualan toko minggu ini turun 15%.",
    "sample_tokens": 96,
    "checkpoint_dir": "checkpoints/kuon-1-loop",
    "log_file": "logs/kuon-1-loop.jsonl",
    "seed": 1337,
    "compile": false
  }
}
