{
  "name": "kuon-107m",
  "model": {
    "vocab_size": 8192,
    "block_size": 1024,
    "n_layer": 16,
    "n_embd": 768,
    "n_head": 12,
    "n_kv_head": 4,
    "ffn_hidden": 2048,
    "dropout": 0.0,
    "tie_word_embeddings": true
  },
  "train": {
    "data_dir": "data/tinystories",
    "steps": 8000,
    "batch_size": 16,
    "grad_accum": 4,
    "lr": 3e-4,
    "min_lr": 3e-5,
    "warmup_steps": 200,
    "weight_decay": 0.1,
    "eval_interval": 250,
    "eval_batches": 20,
    "sample_prompt": "Once upon a time",
    "sample_tokens": 96,
    "checkpoint_dir": "checkpoints/kuon-107m",
    "log_file": "logs/kuon-107m.jsonl",
    "seed": 1337
  }
}
